.  sp -1
.  IP \(bu 2.3
.\}
\fBsample(path, n?, seed?, unlimited?, table?)\fP: reproducible random
N\-row sample.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBschema(path, table?)\fP: column schema only.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBlist_tables(path)\fP: for multi\-table sources (SQLite / DuckDB /
GeoPackage).
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBcount_rows(path, unlimited?, table?)\fP.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBrun_sql(path, query, limit?, unlimited?, table?)\fP: DuckDB against
the file as table \fBdata\fP.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBconvert(input, output, unlimited?, table?)\fP: same surface as
\fB\-\-convert\fP.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBexport_schema(path, target, table?)\fP: same surface as
\fB\-\-export\-schema\fP.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBprofile(path, unlimited?, table?)\fP: per\-column statistics via
SUMMARIZE.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBfind_duplicates(path, key_columns, table?, limit?, unlimited?)\fP:
duplicate rows by key columns.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBfuzzy_duplicates(path, key_columns, method?, threshold?, .\|.\|.)\fP:
cluster near\-duplicate rows (typos, spacing, word order).
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBvalue_frequency(path, column, table?, top_n?, bin?, unlimited?)\fP:
per\-column value counts.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBsearch(path, query, mode?, table?, limit?, unlimited?)\fP: match
cells across all columns.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.  sp -1
.  IP \(bu 2.3
.\}
\fBcompare_schemas(path_a, path_b, table_a?, table_b?)\fP: diff two
files\*(Aq schemas.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
