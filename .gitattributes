# Normalize line endings: store everything LF in the repo, auto-detect binary,
# and check it out LF everywhere. Without `eol=lf` a Windows checkout turns
# every text file into CRLF, so the fixtures and the `include_str!` files the
# Windows CI job and release build see differ from what Linux and macOS test.
* text=auto eol=lf
# Scripts must keep their platform's endings regardless of who commits them.
*.sh  text eol=lf
*.bat text eol=crlf
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
# Rendered by `asciidoctor -b manpage docs/cli/octa.1.adoc` (install.sh does it
# when asciidoctor is present); committed so installs without asciidoctor still
# get a man page. Generated, so keep it out of the language bar and diffs.
octa.1 linguist-generated=true
