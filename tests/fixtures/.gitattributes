# The binary fixtures go through Git LFS, like the samples. CI fetches them
# with `git lfs pull --include="tests/fixtures/**"` (ci.yml::test): without
# that step a checkout holds pointer files and every reader test fails.
# The text fixtures (csv, json, ...) stay ordinary git objects.
*.accdb   filter=lfs diff=lfs merge=lfs -text
*.mdb     filter=lfs diff=lfs merge=lfs -text
*.dbf     filter=lfs diff=lfs merge=lfs -text
*.mat     filter=lfs diff=lfs merge=lfs -text
*.qvd     filter=lfs diff=lfs merge=lfs -text
*.xpt     filter=lfs diff=lfs merge=lfs -text
*.rds     filter=lfs diff=lfs merge=lfs -text
*.h5      filter=lfs diff=lfs merge=lfs -text
*.nc      filter=lfs diff=lfs merge=lfs -text
*.npz     filter=lfs diff=lfs merge=lfs -text
*.xlsx    filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.arrow   filter=lfs diff=lfs merge=lfs -text
*.avro    filter=lfs diff=lfs merge=lfs -text
*.orc     filter=lfs diff=lfs merge=lfs -text
