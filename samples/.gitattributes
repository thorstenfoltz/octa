# The binary sample files go through Git LFS, the way the fonts and screenshots
# already do. The text ones (csv, json, md, sql, toml, ...) deliberately do not:
# their whole value is that a diff of them is readable.
#
# Scoped to this directory on purpose. `tests/fixtures` holds the same kinds of
# file as ordinary git objects and is left alone.
*.parquet  filter=lfs diff=lfs merge=lfs -text
*.xlsx     filter=lfs diff=lfs merge=lfs -text
*.ods      filter=lfs diff=lfs merge=lfs -text
*.avro     filter=lfs diff=lfs merge=lfs -text
